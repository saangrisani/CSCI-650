{
  "name": "node-red-vader-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node-RED course records and vader, a local flow-review agent",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node-red --settings node-red/settings.cjs --userDir .runtime/node-red",
    "vader": "node vader/cli.mjs",
    "vader:serve": "node vader/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "vader:app": "electron .",
    "vader:build": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "node-red": "5.0.8"
  },
  "devDependencies": {
    "electron": "44.9.3"
  },
  "main": "desktop/main.cjs"
}
